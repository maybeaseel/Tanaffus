<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource TnfBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TnfText}" />
        <Setter Property="FontFamily" Value="PlexRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TnfText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TnfTextMuted}" />
        <Setter Property="FontFamily" Value="PlexRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource TnfPrimary}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TnfTextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TnfRed}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TnfSurface}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TnfSurface}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TnfPrimaryLight}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource TnfPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="PlexSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="SegButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource TnfPrimaryLight}" />
        <Setter Property="TextColor" Value="{StaticResource TnfPrimary}" />
        <Setter Property="FontFamily" Value="PlexSemiBold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TnfPrimary}" />
        <Setter Property="FontFamily" Value="PlexSemiBold" />
    </Style>
</ResourceDictionary>
